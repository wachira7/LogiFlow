# .env - LogiFlow Consolidated Environment Variables
# This file contains ALL environment variables for backend, frontend, and Docker

# =============================================================================
# Django Settings
# =============================================================================
SECRET_KEY=django-insecure-hg2iqi*hhg=)*_+^3eql!_vxj-_qk#y$(*9ts4p!+-tpl5d%yd
DEBUG=True
DJANGO_SETTINGS_MODULE=logistics_project.settings
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,*.ngrok-free.app

# =============================================================================
# Database (PostgreSQL for Docker)
# =============================================================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=logiflow
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================================================
# Frontend Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=LogiFlow
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENVIRONMENT=development
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True

# =============================================================================
# JWT Configuration
# =============================================================================
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256
ROTATE_REFRESH_TOKENS=True
BLACKLIST_AFTER_ROTATION=True

# =============================================================================
# Email Configuration
# =============================================================================
