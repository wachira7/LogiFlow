# =============================================================================
# Feature Flags
# =============================================================================
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_CHAT_SUPPORT=false
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=true
NEXT_PUBLIC_ENABLE_2FA=false
NEXT_PUBLIC_ENABLE_EMAIL_VERIFICATION=true
NEXT_PUBLIC_ENABLE_MULTI_TENANT=true

# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://redis:6379/1
CACHE_TIMEOUT=300

# =============================================================================
# Performance Settings
# =============================================================================
STORE_PERFORMANCE_METRICS=True
ENABLE_RATE_LIMITING=False
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_ENABLE_API_CACHE=true

# =============================================================================
# Pagination Settings
# =============================================================================
STANDARD_PAGE_SIZE=20
LARGE_PAGE_SIZE=50
MAX_PAGE_SIZE=200
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_PAGE_SIZE=200

# =============================================================================
# File Upload Configuration
# =============================================================================
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
MEDIA_ROOT=media
STATIC_ROOT=staticfiles
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,xlsx,csv

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=DEBUG
LOG_DIR=logs
NEXT_PUBLIC_LOG_LEVEL=debug

# =============================================================================
# Security Settings (Development)
# =============================================================================
SECURE_BROWSER_XSS_FILTER=False
SECURE_CONTENT_TYPE_NOSNIFF=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# =============================================================================
# Development Tools
# =============================================================================
ENABLE_DEBUG_TOOLBAR=True
ENABLE_SWAGGER_UI=True
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_SHOW_DEV_TOOLS=true

# =============================================================================
# Regional Settings
# =============================================================================
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_TIMEZONE=UTC
NEXT_PUBLIC_MPESA_REGION=KE

# =============================================================================
# WebSocket Configuration
# =============================================================================
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_ENABLE_REALTIME=false

# =============================================================================
# Superuser (for Docker entrypoint)
# =============================================================================
DJANGO_SUPERUSER_PASSWORD=admin123


