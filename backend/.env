# =============================================================================
# File Upload Configuration
# =============================================================================
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# =============================================================================
# Performance and Rate Limiting
# =============================================================================
STORE_PERFORMANCE_METRICS=True
ENABLE_RATE_LIMITING=False
ANONYMOUS_RATE_LIMIT=100,3600
AUTHENTICATED_RATE_LIMIT=800,3600
PREMIUM_RATE_LIMIT=2000,3600
ENTERPRISE_RATE_LIMIT=5000,3600

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=DEBUG
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# Health Check Configuration
# =============================================================================
DATABASE_CHECK=True
CACHE_CHECK=True
EXTERNAL_SERVICES_CHECK=False

# =============================================================================
# Pagination Settings
# =============================================================================
STANDARD_PAGE_SIZE=20
LARGE_PAGE_SIZE=50
SMALL_PAGE_SIZE=10
DASHBOARD_PAGE_SIZE=5
SEARCH_PAGE_SIZE=15
MAX_PAGE_SIZE=200

# =============================================================================
# Security Settings
# =============================================================================
# Enable security features in production
SECURE_BROWSER_XSS_FILTER=False
SECURE_CONTENT_TYPE_NOSNIFF=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# =============================================================================
# Celery Configuration (for async tasks - optional)
# =============================================================================
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_ACCEPT_CONTENT=application/json
# CELERY_TASK_SERIALIZER=json
# CELERY_RESULT_SERIALIZER=json
# CELERY_TIMEZONE=UTC

