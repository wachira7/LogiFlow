# Logiflow Environment Variables Template
# Copy this file to .env and fill in your actual values

# Django Settings
SECRET_KEY=your-secret-key-here-make-it-very-long-and-random
DEBUG=True
ENVIRONMENT=development

# Database Configuration
DB_NAME=logiflow_db
DB_USER=logiflow_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration (for caching and Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Platform Email Settings (emails sent FROM your platform)
EMAIL_HOST_USER=noreply@logiflow.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_FROM=Logiflow <noreply@logiflow.com>

# Admin Notification Emails (YOU receive these notifications)
ADMIN_EMAIL=warumanu254@gmail.com
PLATFORM_ADMIN_EMAIL=admin@logiflow.com
SUPPORT_EMAIL=support@logiflow.com

# Email Templates
WELCOME_EMAIL_TEMPLATE=emails/welcome.html
NOTIFICATION_EMAIL_TEMPLATE=emails/notification.html

# Stripe Configuration (for payments)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# M-Pesa Configuration (for African payments)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey

# AWS Configuration (for production)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=logiflow-storage
AWS_S3_REGION_NAME=us-east-1

# Platform Configuration
PLATFORM_NAME=Logiflow
PLATFORM_DOMAIN=localhost:3000
API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:3000

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,xlsx,csv

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/logiflow.log

# Development Tools
ENABLE_DEBUG_TOOLBAR=True
ENABLE_SWAGGER=True

# ── Transactional email ──────────────────────────────────────────────────
# EMAIL_PROVIDER: "smtp" (EMAIL_HOST etc. above, e.g. Gmail + app password) or "resend".
# Defaults to "resend" when RESEND_API_KEY is set.
EMAIL_PROVIDER=smtp
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=LogiFlow <noreply@mail.yourdomain.com>   # must be a verified Resend domain
# Inbox that receives contact form messages
CONTACT_EMAIL=team@example.com

